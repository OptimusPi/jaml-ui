{
  "name": "jaml-ui",
  "version": "4.4.0",
  "description": "Zero-dependency json-render engine + Balatro card sprites for MCP Apps.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./motely": {
      "types": "./dist/motely.d.ts",
      "default": "./dist/motely.js"
    },
    "./webmcp": {
      "types": "./dist/webmcp.d.ts",
      "default": "./dist/webmcp.js"
    },
    "./jimbo.css": "./dist/ui/jimbo.css",
    "./fonts.css": "./fonts.css",
    "./assets/*": "./assets/*"
  },
  "sideEffects": [
    "./fonts.css",
    "./dist/ui/jimbo.css",
    "./dist/index.js"
  ],
  "files": [
    "dist",
    "assets/*.png",
    "assets/fonts",
    "fonts.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "storybook dev --port 3000 --host 0.0.0.0",
    "dev:watch": "vite build --watch",
    "jaml:mcp": "node scripts/jaml-mcp-server.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:all": "npm run typecheck",
    "prepack": "npm run build",
    "storybook": "npm run build && storybook dev --port 3000 --host 0.0.0.0",
    "build-storybook": "npm run build && storybook build",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OptimusPi/jaml-ui"
  },
  "homepage": "https://github.com/OptimusPi/jaml-ui#readme",
  "bugs": {
    "url": "https://github.com/OptimusPi/jaml-ui/issues"
  },
  "keywords": [
    "balatro",
    "jaml",
    "motely",
    "seed",
    "card",
    "sprite",
    "ui",
    "json-render",
    "mcp",
    "webmcp"
  ],
  "author": "pifreak",
  "license": "MIT",
  "dependencies": {
    "react-icons": "^5.7.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "motely-wasm": "^32.1.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tsdown/css": "0.23.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^30.1.3",
    "motely-wasm": "^32.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.30.0"
}