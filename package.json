{
  "name": "jaml-ui",
  "version": "10.0.0",
  "description": "Balatro-style React primitives on Base UI. One look, shared by every JAML site.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./sprites": {
      "types": "./dist/sprites.d.ts",
      "default": "./dist/sprites.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "default": "./dist/assets.js"
    },
    "./motely": {
      "types": "./dist/motely.d.ts",
      "default": "./dist/motely.js"
    },
    "./motd": {
      "types": "./dist/motd.d.ts",
      "default": "./dist/motd.js"
    },
    "./styles.css": "./dist/styles/jaml.css",
    "./jimbo.css": "./dist/ui/jimbo.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./tailwind.css": "./dist/styles/tailwind.css",
    "./fonts.css": "./fonts.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "fonts.css",
    "AGENTS.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "vocab:check": "node --experimental-strip-types scripts/check-vocab-drift.mjs",
    "decode:check": "node scripts/check-decoder.mjs",
    "lut:emit": "node scripts/emit-motely-sprite-lut.mjs",
    "motd:emit": "node scripts/emit-motds.mjs",
    "gen:grammar": "node scripts/gen-engine-grammar.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "motely-wasm": "^31.1.1",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@json-render/core": "^0.20.0",
    "@json-render/react": "^0.20.0",
    "react-icons": "^5.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-mcp": "^10.6.2",
    "@storybook/addon-themes": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tsdown/css": "0.23.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "motely-wasm": "^31.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.2",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.30.0"
}
