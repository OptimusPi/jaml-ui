{
  "name": "jaml-ui",
  "version": "10.0.0-alpha.0",
  "description": "Balatro-style React primitives on Base UI. One look, shared by every JAML site.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./styles.css": "./dist/styles/jaml.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./tailwind.css": "./dist/styles/tailwind.css",
    "./fonts.css": "./fonts.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "fonts.css",
    "AGENTS.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-mcp": "^10.6.2",
    "@storybook/addon-themes": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.2",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@10.30.0"
}
